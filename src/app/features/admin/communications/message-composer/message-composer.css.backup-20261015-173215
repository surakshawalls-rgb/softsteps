.composer-shell {
  display: grid;
  gap: 2rem;
  padding: 2rem 0 3rem;
}

.composer-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1rem;
}

.eyebrow {
  margin: 0 0 0.45rem;
  color: #935f2b;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.composer-header h1 {
  margin: 0;
  color: #1f1a17;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(2.5rem, 3vw, 3.2rem);
  line-height: 1;
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 1.1rem;
  border: 1px solid rgba(31, 26, 23, 0.12);
  border-radius: 999px;
  background: transparent;
  color: #1f1a17;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-decoration: none;
  text-transform: uppercase;
}

.composer-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
  gap: 1.4rem;
}

.panel {
  border: 1px solid rgba(41, 37, 31, 0.08);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 12px 26px rgba(26, 22, 18, 0.04);
}

.form-panel {
  display: grid;
  gap: 1rem;
  padding: 1.6rem;
}

.preview-panel {
  padding: 1.4rem 1.3rem;
}

.field-group {
  display: grid;
  gap: 0.5rem;
}

.field-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

label {
  color: #413a35;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

input,
select,
textarea {
  width: 100%;
  border: 1px solid rgba(41, 37, 31, 0.12);
  border-radius: 14px;
  background: #fffdfb;
  color: #1f1a17;
  font: inherit;
  resize: vertical;
}

input,
select {
  min-height: 48px;
  padding: 0.8rem 0.9rem;
}

textarea {
  min-height: 120px;
  padding: 0.85rem 0.9rem;
}

.segmented-control {
  display: inline-flex;
  gap: 0.5rem;
  padding: 0.35rem;
  border: 1px solid rgba(41, 37, 31, 0.08);
  border-radius: 999px;
  background: rgba(247, 243, 238, 0.9);
}

.segment {
  min-width: 118px;
  min-height: 40px;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: #514a41;
  cursor: pointer;
  font: inherit;
  font-weight: 700;
}

.segment.active {
  background: #29261f;
  color: #fffdf9;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 1.1rem;
  border: none;
  border-radius: 999px;
  background: #29261f;
  color: #fffdf9;
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.primary-button:disabled {
  opacity: 0.7;
  cursor: wait;
}

.action-row {
  display: flex;
  justify-content: flex-end;
}

.status-message {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 0.85rem 1rem;
  border-radius: 12px;
  font-size: 0.9rem;
}

.status-message.success {
  background: rgba(31, 116, 67, 0.1);
  border: 1px solid rgba(31, 116, 67, 0.2);
  color: #165d39;
}

.status-message.error {
  background: rgba(163, 35, 35, 0.08);
  border: 1px solid rgba(163, 35, 35, 0.2);
  color: #8d2d2d;
}

.preview-panel {
  display: grid;
  gap: 1rem;
}

.panel-header h2 {
  margin: 0;
  color: #1f1a17;
  font-size: 1.1rem;
}

.preview-card {
  display: grid;
  gap: 0.9rem;
  padding: 1rem;
  border: 1px solid rgba(41, 37, 31, 0.08);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(252, 249, 246, 0.95), rgba(246, 241, 235, 0.9));
}

.preview-meta {
  display: grid;
  gap: 0.2rem;
}

.preview-meta span {
  color: #7a6f67;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.preview-meta strong {
  color: #1f1a17;
  font-size: 0.9rem;
  word-break: break-word;
}

.preview-content {
  padding: 1rem;
  border: 1px solid rgba(41, 37, 31, 0.08);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.7);
}

.preview-content pre {
  margin: 0;
  color: #2b2724;
  font-family: "Segoe UI", sans-serif;
  font-size: 0.9rem;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

@media (max-width: 820px) {
  .composer-grid,
  .field-row {
    grid-template-columns: 1fr;
  }

  .composer-header {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* Buyer outreach attachments */
.attachment-picker small {
  display: block;
  margin-top: 0.4rem;
  color: var(--muted, #737373);
  font-size: 0.8rem;
}
.attachment-list {
  display: grid;
  gap: 0.5rem;
  padding: 0;
  margin: 0.75rem 0 0;
  list-style: none;
}
.attachment-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.65rem 0.75rem;
  border: 1px solid var(--border, #dedede);
  border-radius: 0.6rem;
  overflow-wrap: anywhere;
}
